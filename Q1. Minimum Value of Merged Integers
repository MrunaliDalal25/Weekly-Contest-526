class Solution {
    public int minMergedInteger(int[] nums) {

        int min = Integer.MAX_VALUE;

        for (int i = 0; i < nums.length; i += 2) {

            int first = nums[i];
            int second = nums[i + 1];

            int multiplier = 10;

            while (multiplier <= second) {
                multiplier *= 10;
            }

            int merged = first * multiplier + second;

            min = Math.min(min, merged);
        }

        return min;
    }
}
