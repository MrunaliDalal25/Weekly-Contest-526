class Solution {

    public int minOperations(int[] nums, int[] locked, int k) {

        int n = nums.length;

        int[] suffixMin = new int[n];
        int prefixMax = 0;

        // Calculate suffix minimums.
        suffixMin[n - 1] = nums[n - 1];

        for (int i = n - 2; i >= 0; i--) {
            suffixMin[i] = Math.min(nums[i], suffixMin[i + 1]);
        }

        // Count locked indices that participate in inversions.
        int unlockCount = 0;

        for (int i = 0; i < n; i++) {

            prefixMax = Math.max(prefixMax, nums[i]);

            if (prefixMax > suffixMin[i] && locked[i] == 1) {
                unlockCount++;
            }
        }

        if (unlockCount > k) {
            return -1;
        }

        // Count inversions using Fenwick Tree.
        int[] bit = new int[n + 1];
        int swaps = 0;

        for (int i = n - 1; i >= 0; i--) {

            swaps += query(bit, nums[i] - 1);

            update(bit, n, nums[i]);
        }

        return unlockCount + swaps;
    }

    private void update(int[] bit, int n, int index) {

        while (index <= n) {
            bit[index]++;
            index += index & -index;
        }
    }

    private int query(int[] bit, int index) {

        int sum = 0;

        while (index > 0) {
            sum += bit[index];
            index -= index & -index;
        }

        return sum;
    }
}
